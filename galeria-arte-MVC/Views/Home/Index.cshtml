@using galeria_arte_MVC.Models

@{
	ViewData["Title"] = "Galería de Arte";
}

<style>
	body {
		background: #f5f5f5;
		font-family: 'Segoe UI', sans-serif;
	}

	.hero {
		text-align: center;
		padding: 70px 20px;
	}

		.hero h1 {
			font-size: 3rem;
			font-weight: 300;
			letter-spacing: 3px;
			color: #222;
		}

		.hero p {
			color: #777;
			font-size: 1.1rem;
			margin-top: 10px;
		}

	.gallery-card {
		background: white;
		border: none;
		border-radius: 15px;
		overflow: hidden;
		transition: 300ms;
		box-shadow: 0 5px 15px rgba(0,0,0,.08);
	}

		.gallery-card:hover {
			/* transform: translateY(-8px); */
			box-shadow: 0 15px 30px rgba(0,0,0,.15);
			cursor:pointer;
		}

		.gallery-card img {
			width: 100%;
			height: 320px;
			object-fit: cover;
		}

		.gallery-card .card-body {
			padding: 25px;
		}

		.gallery-card h5 {
			font-size: 1.3rem;
			font-weight: 600;
			color: #222;
		}

		.gallery-card p {
			color: #777;
			margin-bottom: 0;
		}

		.gallery-card .date {
			margin-top: 12px;
			font-size: .9rem;
			color: #999;
		}
</style>

<div class="hero">
	<h1>Galería de Arte</h1>
	<p>Una colección de obras que capturan emociones e historias.</p>
</div>

<div class="container pb-5">

	<div class="row g-4">
		@foreach (var item in Model){
			<div class="col-lg-4 col-md-6">

				<div class="gallery-card">

					<img src="@item.UrlImagen" loading="lazy" alt="Obra">

					<div class="card-body">
						<h5>@item.Titulo</h5>

						<p>
							@item.Estilo
						</p>

						<a asp-controller="Obra" asp-action="Details" asp-route-id="@item.Id">Detalles</a>
					</div>

				</div>
			</div>
		}


	</div>

</div>