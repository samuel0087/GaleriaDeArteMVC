@model galeria_arte_MVC.Models.Exposicion

@{
    ViewData["Title"] = Model.Nombre;
}

<style>
    .obra-card {
        position: relative;
        overflow: hidden;
        transition: .3s;
    }

    .btn-delete {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        background: #dc3545;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1rem;
        opacity: 0;
        transition: .25s;
        z-index: 10;
        text-decoration: none;
        font-weight: 700;
        font-size: 22px;
    }

        .btn-delete:hover {
            background: #bb2d3b;
            transform: scale(1.12);
            box-shadow: 0 0 18px rgba(220,53,69,.45);
            opacity: 1;
        }

        .btn-delete:active {
            transform: scale(.95);
        }

        .obra-card:hover .btn-delete {
            opacity: 1;
            transform: scale(1);
        }

    .obra-card:hover {
        transform: translateY(-5px);
    }
</style>

<div class="container py-5">

    <div class="card shadow border-0">

        <div class="card-body p-5">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <span class="badge bg-dark mb-2">Exposición</span>

                    <h1 class="display-5 fw-light">
                        @Model.Nombre
                    </h1>

                    <p class="text-muted">
                        Una colección de obras cuidadosamente seleccionadas.
                    </p>
                </div>

                <div class="text-end">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-dark">
                        Editar
                    </a>

                </div>

            </div>

            <hr class="my-4" />

            <div class="row text-center">

                <div class="col-md-4">

                    <h6 class="text-uppercase text-secondary">
                        Inicio
                    </h6>

                    <h4>
                        @Model.FechaInicio.ToString("dd/MM/yyyy")
                    </h4>

                </div>

                <div class="col-md-4">

                    <h6 class="text-uppercase text-secondary">
                        Finaliza
                    </h6>

                    <h4>
                        @Model.FechaFinal.ToString("dd/MM/yyyy")
                    </h4>

                </div>

                <div class="col-md-4">

                    <h6 class="text-uppercase text-secondary">
                        Obras
                    </h6>

                    <h4>
                        @(Model.ObrasExpuestas?.Count ?? 0)
                    </h4>

                </div>

            </div>

        </div>

    </div>


    <div class="d-flex justify-content-between align-items-center mt-5">

        <h2 class="fw-light">
            Obras de la exposición
        </h2>

        <a asp-action="SeleccionObra"
           asp-route-id="@Model.Id"
           class="btn btn-dark">
            Agregar Obras
        </a>

    </div>

    <hr />

    @if (Model.ObrasExpuestas != null && Model.ObrasExpuestas.Any())
    {
        <div class="row g-4 mt-2">

            @foreach (var obra in Model.ObrasExpuestas)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">

                    <div class="card obra-card h-100 shadow-sm border-0">

                        <a class="btn-delete" asp-action="QuitarObra" asp-controller="Exposicion" asp-route-idExpo="@Model.Id" asp-route-idObra="@obra.Id">
                            X
                        </a>

                        <img src="@obra.UrlImagen"
                             class="card-img-top"
                             style="height:260px;object-fit:cover;" />

                        <div class="card-body">

                            <h5 class="card-title">
                                @obra.Titulo
                            </h5>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-light border mt-4">

            <h5>No hay obras asignadas.</h5>

            <p class="mb-0">
                Agrega obras para comenzar a construir la exposición.
            </p>

        </div>
    }

    <div class="mt-5">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Volver a Exposiciones
        </a>

    </div>

</div>